{
    "manifest_version": 3,
    "name": "YapPilot",
    "version": "2.0.1",
    "description": "AI-assisted X engagement with configurable likes, contextual replies, delays, and activity tracking.",
    "author": "Vinsen - Yapper Indo",
    "permissions": [
        "tabs",
        "storage",
        "activeTab",
        "scripting",
        "sidePanel"
    ],
    "host_permissions": [
        "*://x.com/*",
        "*://twitter.com/*",
        "https://auto-yap-api.vercel.app/*",
        "https://api.openai.com/*",
        "https://api.anthropic.com/*",
        "https://api.x.ai/*",
        "https://api.deepseek.com/*",
        "https://generativelanguage.googleapis.com/*",
        "https://api.groq.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/yap16.png",
            "48": "icons/yap48.png",
            "128": "icons/yap128.png"
        }
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "*://x.com/*",
                "*://twitter.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/yap16.png",
        "48": "icons/yap48.png",
        "128": "icons/yap128.png"
    },
    "options_page": "settings.html",
    "short_name": "YapPilot"
}